# Never commit real keys.
# Locally: put these in backend/.env. On Vercel: Project > Settings > Environment Variables.

# Optional: where `npm run dev` forwards /api/* (default http://localhost:8000). Not used on Vercel.
BACKEND_URL=

# Gemini, from Google AI Studio (mlh.link/aistudio)
GEMINI_API_KEY=
# Main model, e.g. gemini-3.1-flash-lite (check speed with POST /debug/gemini-speed?model=...)
GEMINI_MODEL=
# Optional: models to try when the main one is overloaded or out of quota (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview
# ElevenLabs text to speech (mlh.link/elevenlabs)
ELEVENLABS_API_KEY=
# Required with the key: which voice speaks (ElevenLabs > Voices > a voice > ID)
ELEVENLABS_VOICE_ID=
# Optional: default eleven_flash_v2_5
ELEVENLABS_MODEL=
# Tiger Data Postgres connection string (mlh.link/tigerdata)
DATABASE_URL=
# Optional: Google's bicycle route in the /debug page and benchmark.py (needs Routes API + billing)
GOOGLE_MAPS_API_KEY=
