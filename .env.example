# Never commit real keys.
# Locally: put these in backend/.env. On Vercel: Project > Settings > Environment Variables.

# Optional: where `npm run dev` forwards /api/* (default http://localhost:8000). Not used on Vercel.
BACKEND_URL=

# Gemini, from Google AI Studio (mlh.link/aistudio)
GEMINI_API_KEY=
# ElevenLabs text to speech (mlh.link/elevenlabs)
ELEVENLABS_API_KEY=
# Tiger Data Postgres connection string (mlh.link/tigerdata)
DATABASE_URL=
# Optional: Google's bicycle route in the /debug page and benchmark.py (needs Routes API + billing)
GOOGLE_MAPS_API_KEY=
